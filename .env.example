# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ถูก .gitignore ไว้แล้ว ห้าม commit ค่าจริง)
# ใช้กับสคริปต์ใน tools/ เท่านั้น (แอป Streamlit หลักใช้ .streamlit/secrets.toml แยกต่างหาก)

# ─── ใช้อยู่แล้วโดย tools/sync_carrier_zones.py, tools/check_iship_couriers.py ───
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=xxxxx

# ─── tools/email_daily_digest.py ───────────────────────────────────────────────
# JSON list ของบัญชีอีเมลที่จะเช็ค — ต้องเป็น IMAP + password ตรงๆ ได้เท่านั้น
# (Gmail: เปิด 2-Step Verification แล้วสร้าง App Password ที่
#  myaccount.google.com/apppasswords — ใช้ 16 หลักที่ได้แทนรหัสผ่านจริง
#  Outlook/Hotmail/M365: ยังไม่รองรับ — ปิด basic auth ไปแล้ว ต้องทำ OAuth2 แยก)
EMAIL_ACCOUNTS=[{"host":"imap.gmail.com","user":"you@gmail.com","password":"xxxx xxxx xxxx xxxx","label":"gmail-hq"}]

# ใช้ร่วมกับแอปหลัก (ปกติตั้งใน .streamlit/secrets.toml) แต่สคริปต์ standalone อ่านจาก .env นี้แทน
LINE_CHANNEL_ACCESS_TOKEN=xxxxx

# line_user_id ส่วนตัวของเจ้าของร้าน (ปลายทางที่จะส่งสรุปอีเมลรายวันไปหา) — หาได้โดยทักแอด
# LINE OA ของร้านแล้วพิมพ์ "สมัคร <เบอร์โทร>" เหมือนลูกค้าลงทะเบียน (ดู gas_line_webhook.js)
# แล้วดู line_user_id ที่ webhook เขียนกลับเข้า Supabase ตาราง customers
STAFF_LINE_USER_ID=xxxxx

# ─── tools/backup_to_drive.py + tools/gdrive_get_refresh_token.py ──────────────
# Backup ข้อมูล Supabase ทุกตารางขึ้น Google Drive อัตโนมัติทุกวัน (ผ่าน GitHub
# Actions cron — ดู .github/workflows/backup.yml) วิธีขอค่าทั้ง 3 ตัวนี้ดูขั้นตอน
# เต็มในคอมเมนต์บนสุดของ tools/gdrive_get_refresh_token.py — รันไฟล์นั้นครั้งเดียว
# จะได้ GDRIVE_REFRESH_TOKEN มาโดยอัตโนมัติ (client id/secret ต้องสร้างเองก่อน)
GDRIVE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GDRIVE_CLIENT_SECRET=xxxxx
GDRIVE_REFRESH_TOKEN=xxxxx
# ID โฟลเดอร์ปลายทางใน Google Drive (จาก URL: drive.google.com/drive/folders/<ID>)
GDRIVE_FOLDER_ID=xxxxx
